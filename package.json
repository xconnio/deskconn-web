{
  "name": "deskconn-web-app",
  "productName": "DeskConn",
  "version": "0.0.0",
  "description": "DeskConn client",
  "author": "XConnIO",
  "main": "electron/main.js",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test:transports": "node tests/transports.mjs",
    "electron:start": "electron .",
    "electron:dev": "run-p -r \"dev -- --strictPort\" \"electron:start -- --dev-url=http://localhost:5173\"",
    "electron:build": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/ed25519": "^3.2.0",
    "@popperjs/core": "^2.11.8",
    "@xconnio/xconn": "^0.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "diff-match-patch": "^1.0.5",
    "highlight.js": "^11.12.0",
    "idb-keyval": "^6.3.0",
    "material-icon-theme": "^5.39.0",
    "pinia": "^4.1.0",
    "ssh2": "^1.17.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue3-otp-input": "^0.5.40"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/bootstrap": "^5.2.11",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "build": {
    "npmRebuild": false,
    "appId": "io.xconn.deskconn",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**",
      "electron/main.js",
      "electron/resources/icon.png",
      "!dist/CNAME",
      "!node_modules/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "electron/resources/icon.png",
      "executableName": "deskconn-desktop",
      "maintainer": "XConnIO <info@xconn.io>",
      "syncDesktopName": true
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "deb": {
      "packageName": "deskconn-desktop"
    },
    "artifactName": "deskconn-desktop-${version}-${os}-${arch}.${ext}"
  },
  "desktopName": "deskconn-desktop.desktop"
}
